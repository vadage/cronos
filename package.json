{
  "name": "cronos",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "schema:generate": "drizzle-kit generate",
    "schema:migrate": "wrangler d1 migrations apply cronos",
    "typecheck": "tsc",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cronjob",
    "monitor",
    "serverless",
    "cloudflare"
  ],
  "author": "vadage",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.27",
    "nanoid": "^6.0.0",
    "svelte": "^5.56.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "wrangler": "^4.134.0"
  }
}
